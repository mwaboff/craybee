# Copy to .env and edit. All settings are optional.
CRAYBEE_DEBUG=false
CRAYBEE_HOST=127.0.0.1
CRAYBEE_PORT=8000

# Read once, on first start, to seed the default LLM server (an OpenAI-compatible
# endpoint such as LM Studio). Afterwards the database row is the source of truth;
# manage servers via /api/v1/llm-servers.
CRAYBEE_LLM_HOST=127.0.0.1
CRAYBEE_LLM_PORT=1234
CRAYBEE_LLM_SCHEME=http

CRAYBEE_LLM_MODEL="local-model"